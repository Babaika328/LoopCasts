    {
      "parameters": {
        "jsCode": "const p = $input.first().json;\nconst m = p.metadata;\n\n// What the provider says was paid, in cents.\nconst paid = Math.round(parseFloat(p.amount.value) * 100);\n\n// Work out the VAT rule again, independently of the website.\nconst isCompany = !!m.company;\nconst rule = (isCompany && m.vat_number && m.country !== 'BE') ? 'reverse_charge' : 'belgian_21';\nconst vat = rule === 'reverse_charge' ? 0 : Math.floor((m.amount_excl_cents * 21 + 50) / 100);\nconst expected = m.amount_excl_cents + vat;\n\nif (rule !== m.vat_rule || vat !== m.vat_cents || paid !== expected) {\n  throw new Error(`Amount check failed for ${p.id}: paid ${paid}, expected ${expected} (${rule})`);\n}\n\nreturn [{ json: {\n  payment_id: p.id,\n  plan: m.plan,\n  course: m.course,\n  name: m.name,\n  email: m.email,\n  company: m.company,\n  vat_number: m.vat_number,\n  country: m.country,\n  amount_excl_cents: m.amount_excl_cents,\n  vat_cents: vat,\n  vat_rule: rule,\n} }];"
      },
