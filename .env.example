# Copy to .env and fill in real values. .env is gitignored; this file is not.
# Placeholder values only — never put real secrets in this file.

# --- Database (members area rewrite + order table; ddev provides these locally) ---
DB_HOST=db
DB_NAME=loopcasts
DB_USER=changeme
DB_PASSWORD=changeme

# --- Invoicing service (Billit or Yuki — not chosen yet) ---
INVOICING_API_BASE_URL=
INVOICING_API_KEY=changeme

# --- Order intake webhook (shared secret so random POSTs get rejected) ---
ORDER_WEBHOOK_SECRET=changeme

# --- Vimeo + transcription (captioning workflow, optional / later) ---
VIMEO_ACCESS_TOKEN=changeme
TRANSCRIPTION_API_KEY=changeme

# --- Bank aggregator (only if the invoicing service can't match payments itself) ---
# PONTO_CLIENT_ID=
# PONTO_CLIENT_SECRET=

# --- Members area (site) ---
# The API key n8n uses to give a customer access after payment. The development default is fine locally; set a real one in production.
MEMBERS_API_KEY=changeme
# Base address used in the links in emails (never taken from the request). DDEV provides it automatically.
SITE_URL=https://loopcasts.ddev.site
MAIL_FROM=LoopCasts <noreply@loopcasts.test>
